# Variable names only. Never put real values in this file.
# Server-side secrets must NOT start with VITE_: Vite inlines every VITE_*
# variable into the public JavaScript bundle (`npm run build` fails if one
# looks like a secret, see scripts/check-no-secrets.mjs).

# --- Server (Vercel Functions in api/) -------------------------------------------
# Gemini API key. Restrict it to the Generative Language API, with daily and
# per-minute quotas set in Google Cloud.
GEMINI_API_KEY=

# Long random string used to hash client IPs for rate limiting.
RATE_LIMIT_SALT=

# Optional. Fine-grained, read-only token (public repositories only) for the
# GitHub context in the chat prompt.
GITHUB_TOKEN=

# Upstash Redis REST credentials. The UPSTASH_* names win; the KV_* names
# (set by the Vercel/Upstash integration) are the fallback. Required in
# production and previews: without them the AI endpoints return 503.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Local development only ------------------------------------------------------
# Enables /api/chat and /api/live-token under `vercel dev`. Without Redis
# credentials an in-memory rate limiter is used locally.
ALLOW_DEV_AI=1
